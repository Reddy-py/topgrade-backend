# Port number on which the backend server listens
PORT=

# Application execution environment (development, production, test)
NODE_ENV=

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
CORS_ORIGIN=

# URL endpoint for the Supabase project
SUPABASE_URL=

# Public anonymous API key for Supabase
SUPABASE_ANON_KEY=

# Service role privileged API key for administrative Supabase operations
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL database connection URL for migrations and administration
DATABASE_URL=

# Default IANA time zone identifier for the institute (e.g. America/New_York)
INSTITUTE_TIMEZONE=

# Base URL of the client frontend application
FRONTEND_URL=

# Primary administrator email address for receiving system alerts and escalation notices
ADMIN_EMAIL=

# Gmail account address used for authenticating SMTP email dispatch
GMAIL_USER=

# Display sender address used in outgoing notification emails
GMAIL_SENDER_EMAIL=

# Google App Password for authenticated SMTP email transport
GMAIL_APP_PASSWORD=

# Hour of day (0-23 in institute time) to trigger automated birthday and exam greeting emails
BIRTHDAY_SEND_HOUR=

# Stripe secret API key for creating payment sessions and processing charges
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for authenticating incoming payment events
STRIPE_WEBHOOK_SECRET=

# Default three-letter ISO currency code used for Stripe charges (e.g. usd)
STRIPE_CURRENCY=

# Currency code used for lesson token balances and ledger entries (e.g. usd)
TOKEN_CURRENCY=

# Maximum number of tokens permitted in a single checkout order
MAX_TOKENS_PER_ORDER=

# Flag allowing mock checkout flows when Stripe keys are not configured in development
ALLOW_MOCK_PAYMENTS=

# Flag allowing in-memory fallback demo services for evaluation
ALLOW_DEMO=

# Base URL of the backend API used by validation and integration scripts
API_BASE=

# Test administrator email used by automated verification scripts
TEST_ADMIN_EMAIL=

# Test administrator password used by automated verification scripts
TEST_ADMIN_PASSWORD=

# Test teacher email used by automated verification scripts
TEST_TEACHER_EMAIL=

# Test teacher password used by automated verification scripts
TEST_TEACHER_PASSWORD=

# Test parent email used by automated verification scripts
TEST_PARENT_EMAIL=

# Test parent password used by automated verification scripts
TEST_PARENT_PASSWORD=

# Test student email used by automated verification scripts
TEST_STUDENT_EMAIL=

# Test student password used by automated verification scripts
TEST_STUDENT_PASSWORD=
