# ==============================================================================
# TOPGRADE ACADEMIC CRM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# In production (NODE_ENV=production), the backend engine enforces strict boot validation
# and will REFUSE TO START if any required variable is missing, or if mock/demo
# switches are enabled.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME (REQUIRED)
# ------------------------------------------------------------------------------
# Port number on which the Express server listens (default: 5000)
PORT=5000

# Application execution environment: "development" | "production" | "test"
# In "production", demo switches are blocked, CORS is strict, and stack traces are suppressed.
NODE_ENV=production

# Fully qualified client frontend URL for generating links and CORS validation
# Example: https://app.topgradeacademy.com
FRONTEND_URL=https://app.topgradeacademy.com

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
# Example: https://app.topgradeacademy.com,https://topgradeacademy.com
CORS_ORIGIN=https://app.topgradeacademy.com

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (REQUIRED)
# ------------------------------------------------------------------------------
# Supabase project REST API endpoint
# Example: https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key for client validation scripts
SUPABASE_ANON_KEY=eyJhbGciOi...

# Privileged service role API key (NEVER expose to client frontend or git)
# Used for backend database administration, bypassing RLS where required.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Direct PostgreSQL connection string for database migrations (e.g. Supabase connection pooler)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 3. EMAIL & NOTIFICATION SERVICE (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Primary system administrator email address for critical alerts and digests
ADMIN_EMAIL=admin@topgrade.edu

# Gmail account address used for authenticating outbound SMTP dispatch
GMAIL_USER=tglbiz101@gmail.com

# Google App Password generated via Google Account Security > 2-Step Verification > App Passwords
# Note: This is a 16-character token, NOT your standard Google account password.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Display sender address used in outgoing notification headers
GMAIL_SENDER_EMAIL=tglbiz101@gmail.com

# Default IANA time zone identifier for the institute (used for schedule calculations)
# Default: America/New_York
INSTITUTE_TIMEZONE=America/New_York

# Hour of day (0-23 in institute time) to trigger automated birthday and exam greeting emails
# Default: 8 (8:00 AM local institute time)
BIRTHDAY_SEND_HOUR=8

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAYS (STRIPE CARD & BANK VERIFIED ZELLE)
# ------------------------------------------------------------------------------
# Stripe secret API key (starts with sk_test_... in dev, sk_live_... in production)
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (starts with whsec_...) obtained from Stripe Dashboard or CLI
STRIPE_WEBHOOK_SECRET=whsec_...

# Default three-letter ISO currency code for Stripe charges
STRIPE_CURRENCY=usd

# Optional webhook secret for direct bank integration feeds (HMAC-SHA256 signature verification)
BANK_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. INITIAL CREDENTIALS & SPREADSHEET IMPORTS (DEPLOYMENT / MIGRATION ONLY)
# ------------------------------------------------------------------------------
# Initial password for newly provisioned administrator accounts
ADMIN_INITIAL_PASSWORD=TopGrade2026!

# Default initial password for batch-imported student and parent logins
DEFAULT_INITIAL_PASSWORD=TopGrade2026!

# Absolute or relative file path to the family data spreadsheet for initial import
IMPORT_XLSX_PATH=./data/families.xlsx

# ------------------------------------------------------------------------------
# 6. TESTING & VERIFICATION FLAGS (DEV / CI ONLY - FORBIDDEN IN PRODUCTION)
# ------------------------------------------------------------------------------
# Flag allowing mock checkout sessions when payment provider is unconfigured (BLOCKED in production)
ALLOW_MOCK_PAYMENTS=false

# Flag allowing in-memory fallback stores (BLOCKED in production)
ALLOW_DEMO=false

# Base URL used by integration and access verification scripts
API_BASE=http://localhost:5000

# Test accounts used by `npm run verify:access`
TEST_ADMIN_EMAIL=admin@topgrade.edu
TEST_ADMIN_PASSWORD=TopGrade2026!
TEST_TEACHER_EMAIL=teacher@topgrade.edu
TEST_TEACHER_PASSWORD=TopGrade2026!
TEST_PARENT_EMAIL=parent@topgrade.edu
TEST_PARENT_PASSWORD=TopGrade2026!
TEST_STUDENT_EMAIL=student@topgrade.edu
TEST_STUDENT_PASSWORD=TopGrade2026!
